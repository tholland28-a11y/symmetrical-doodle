{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "company_profile.schema.json",
  "title": "Company Profile",
  "description": "Stage 1 (Company Discovery) output. A classification of the target company that drives everything downstream. The single most important field is `industry`, which selects the functional template in Stage 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "identity", "businessModel", "industry", "scale", "facts"],
  "properties": {
    "company": {
      "type": "string",
      "description": "The name the engine was pointed at (as provided by the operator)."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalName"],
      "properties": {
        "legalName": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "formerNames": { "type": "array", "items": { "type": "string" } },
        "founded": { "type": "string", "description": "Founding year or date." },
        "hq": { "type": "string" },
        "ownership": {
          "type": "string",
          "enum": ["public", "private", "subsidiary", "nonprofit", "government", "unknown"]
        },
        "ticker": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "businessModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whatItSells", "customers", "revenueModel"],
      "properties": {
        "whatItSells": { "type": "string" },
        "customers": { "type": "string", "description": "To whom it sells." },
        "revenueModel": {
          "type": "string",
          "enum": ["recurring", "project", "transactional", "product", "service", "mixed"]
        },
        "notes": { "type": "string" }
      }
    },
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "description": "Industry classification. `primary` selects the functional template in reference/industry_functions.md.",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "naics": { "type": "string" },
        "sic": { "type": "string" }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "description": "Size signals that calibrate metrics and benchmarks downstream.",
      "properties": {
        "employees": { "type": "string" },
        "revenue": { "type": "string" },
        "locations": { "type": "string" },
        "geography": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "facts": {
      "type": "array",
      "description": "The honesty flag, made structural. Every material fact is tagged verified (neutral / independent / filings) or unverified (company self-description / marketing). This propagates so documents never launder marketing into fact.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "verified", "provenance"],
        "properties": {
          "claim": { "type": "string" },
          "verified": {
            "type": "boolean",
            "description": "true = neutral fact from an independent source (founding, HQ, filings); false = company self-description / marketing (\"leading provider of...\")."
          },
          "provenance": {
            "type": "string",
            "enum": ["company_marketing", "company_filing", "independent", "regulatory", "press", "unknown"]
          },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
